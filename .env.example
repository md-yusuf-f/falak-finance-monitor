# Zerodha / Kite -- required for equity + MF holdings
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Optional: set access token directly instead of OAuth flow
# KITE_ACCESS_TOKEN=your_access_token
# Optional: override token file location (default: data/kite_access_token.txt)
# KITE_ACCESS_TOKEN_FILE=data/kite_access_token.txt

# Binance -- optional (leave blank to skip crypto holdings)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# AI Providers -- at least one required for /api/analyse
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# AI model overrides (optional -- defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-1.5-pro

# Binance USD/INR fallback rate if Frankfurter API is unreachable (default: 84.0)
# FALLBACK_USD_INR=84.0

# Server port (default: 8765)
# PORT=8765

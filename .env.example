# Zerodha / Kite
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=
KITE_ACCESS_TOKEN_FILE=data/kite_access_token.txt

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Groq (free — https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Falak AI (local OpenAI-compatible server e.g. Ollama)
FALAK_AI_BASE_URL=http://localhost:11434/v1
FALAK_AI_MODEL=qwen3:8b
FALAK_AI_API_KEY=ollama

# Gemini (free — https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Database
DB_PATH=data/falak.db

# Server
PORT=8765

# Telegram
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # your personal chat ID
DAILY_REPORT_CRON=0 9 * * *   # 9 AM daily portfolio report
KITE_TOKEN_ALERT_CRON=0 8 * * *  # 8 AM Kite token validity check

# Market Data
MARKET_SYMBOLS=BTC/USDT,ETH/USDT

# Strategy & Paper Trading
EXECUTION_MODE=paper            # paper or live
RISK_PER_TRADE_PCT=0.02         # 2% of paper capital per trade
DAILY_DRAWDOWN_LIMIT=-0.05      # halt paper trading if daily P&L < -5%
   # comma-separated symbols for candle collection
